{
  "manifest_version": 3,
  "name": "SmartWindowSize",
  "version": "__VERSION__",
  "description": "Restores browser window sizes by domain, subdomain, path, or page.",
  "permissions": ["storage", "tabs", "windows", "contextMenus"],
  "background": {
    "scripts": ["background/firefox-background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "SmartWindowSize __VERSION__: enabled",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/active-16.png",
      "32": "icons/active-32.png",
      "48": "icons/active-48.png",
      "128": "icons/active-128.png"
    }
  },
  "icons": {
    "16": "icons/active-16.png",
    "32": "icons/active-32.png",
    "48": "icons/active-48.png",
    "128": "icons/active-128.png"
  },
  "options_page": "options/options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "__FIREFOX_EXTENSION_ID__"
    }
  }
}
